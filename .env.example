# Local infrastructure only. Never commit real credentials.
POSTGRES_USER=chatsphere
POSTGRES_PASSWORD=chatsphere_dev_password
POSTGRES_DB=chatsphere
POSTGRES_PORT=5432

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025


# Local S3Mock. Production uses a real bucket and credentials.
S3_ENDPOINT=http://localhost:9090
S3_REGION=us-east-1
S3_BUCKET=chatsphere-attachments
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_FORCE_PATH_STYLE=true

# Set true when terminating TLS in front of the API.
COOKIE_SECURE=false
