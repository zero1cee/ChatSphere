# Copy to .env.production. Never commit real production secrets.
POSTGRES_USER=chatsphere
POSTGRES_PASSWORD=replace-with-a-long-password
POSTGRES_DB=chatsphere
PUBLIC_ORIGIN=https://chatsphere.example.com
HTTP_PORT=8080
COOKIE_SECURE=true
TRUST_PROXY=true

# Must be at least 32 characters.
JWT_ACCESS_SECRET=replace-with-a-32-character-random-secret

# External S3-compatible storage. The bucket must already exist.
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=chatsphere-attachments
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=false

# External SMTP.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=replace-me
SMTP_PASS=replace-me
SMTP_FROM=ChatSphere <no-reply@chatsphere.example.com>
