NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://chatsphere:chatsphere_dev_password@localhost:5432/chatsphere?schema=public
LOG_LEVEL=debug

# Development-only value. Replace with a randomly generated 32+ character secret.
JWT_ACCESS_SECRET=dev-only-change-this-to-a-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# Mailpit locally. Production should use a real SMTP provider.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=ChatSphere <no-reply@chatsphere.local>
# SMTP_USER=
# SMTP_PASS=

# Leave empty on localhost.
COOKIE_DOMAIN=
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true
